# Copy to .env.local. Every variable is optional; `pnpm demo` needs none of them.

# Linear personal API key (Linear → Settings → Security & access → Personal API keys).
# Read-only use: the sub-issues of each initiative and their states.
LINEAR_API_KEY=

# GitHub user or organisation that owns the repositories named in sub-issue
# titles ("[api] …"). Pull requests are read through the local `gh` login.
GITHUB_OWNER=

# Ticket prefixes of your tracker, comma-separated (ENG,OPS). Without it,
# anything shaped like ABC-123 in a prompt counts as a ticket.
TICKET_PREFIXES=

# Parent folder of the git checkouts a session may be started in.
# Defaults to ~/work/repos.
AGENTS_MONITOR_REPOS=

# The claude binary a launch runs. Defaults to ~/.local/bin/claude.
AGENTS_MONITOR_CLAUDE=

# Where Claude Code stores its data. Defaults to ~/.claude.
CLAUDE_HOME=

# Where a new session starts: tmux (default) or orca, the Orca running on this
# machine. Sessions already running in either are found without this.
AGENTS_MONITOR_TERMINAL=

# The Orca CLI. Defaults to orca; on Linux outside Orca it is orca-ide.
ORCA_BIN=

# Hosts besides localhost the monitor may be opened at and still act on
# sessions, comma-separated (mini.tailnet.ts.net). The monitor has no login:
# set this only on a private network.
AGENTS_MONITOR_ALLOWED_HOSTS=
